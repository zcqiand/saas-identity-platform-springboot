# saas-identity-platform-springboot — 开发期环境变量模板
#
# application.yml 是 SSOT；本文件列出可用 env override（Spring Boot 标准
# relaxed binding 把 yaml 的 ${VAR:default} 自动覆盖；无需改 yaml）。

# —— Server ——
SERVER_PORT=5105

# —— Database（saas_dev 数据库） ——
# 默认 jdbc:postgresql://100.79.128.25:5432/saas_dev（application.yml:18）
# 三选一覆盖：DATABASE_NAME / DATABASE_URL / JDBC_URL
DATABASE_URL=jdbc:postgresql://100.79.128.25:5432/saas_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=saas_dev

# —— CORS ——
# 逗号分隔允许 origin，覆盖 application.yml SecurityConfig 默认列表。
# 默认包含：saas-nextjs :5101 / saas-react :5102 / saas-vue :5103 / lab-nextjs :5201
# 自定义：SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5101,http://localhost:5102
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5101,http://localhost:5102,http://localhost:5103,http://localhost:5201

# —— JWT (HS256, Phase 2A 起删除 DevJwtDecoder, 统一 NimbusJwtDecoder.withSecretKey) ——
# 镜像 saas-identity-platform-{aspnetcore,nextjs} + saas-msw：四仓共享同一 JWT_SIGNING_KEY
# 才能让 MSW 签出来的 access token 在本仓 dev profile 验签通过（≥32B 硬约束）。
# prod 路径：deploy/saas-identity-platform-springboot.sh 首启自举随机密钥持久化进
# springboot.env（append-only, 不覆盖已有），无需本文件提供。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# —— saas-identity-platform 跨 origin ——
# 仅 dev：本仓 :5105 → saas-nextjs :5101（API 路由），无需 reverse proxy