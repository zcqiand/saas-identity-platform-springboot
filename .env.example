# saas-identity-platform-springboot — 开发期环境变量模板
#
# application.yml 是 SSOT；本文件列出可用 env override（Spring Boot 标准
# relaxed binding 把 yaml 的 ${VAR:default} 自动覆盖；无需改 yaml）。

# —— Server ——
SERVER_PORT=8080

# —— Database（saas_dev 数据库） ——
# 默认 jdbc:postgresql://100.79.128.25:5432/saas_dev（application.yml:18）
# 三选一覆盖：SAAS_DB / SPRING_DATASOURCE_URL / JDBC_URL
SPRING_DATASOURCE_URL=jdbc:postgresql://100.79.128.25:5432/saas_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
SAAS_DB=saas_dev

# —— CORS ——
# 逗号分隔允许 origin，覆盖 application.yml SecurityConfig 默认列表。
# 默认包含：saas-nextjs :3000 / lab-react,vue :5173 / lab-nextjs :3001
# 自定义：SAAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# —— saas-identity-platform 跨 origin ——
# 仅 dev：本仓 :8080 → saas-nextjs :3000（API 路由），无需 reverse proxy