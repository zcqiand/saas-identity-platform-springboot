<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude codegen output (DTO + API) -->
    <Match>
        <Package name="saas.identity.shared.dto"/>
    </Match>
    <Match>
        <Package name="saas.identity.shared.api"/>
    </Match>
    <!-- Spring service/controller singleton injection is fine -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Unboxing/reboxing int parameters in scaffold code -->
    <Match>
        <Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/>
    </Match>
    <!--
      NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: codegen-generated DTO getters are
      declared @Nullable for OpenAPI optional fields. SpotBugs cannot statically
      track short-circuit null checks (a == null ? b : a) and flags false
      positives on every nullable setter. Code is correct under manual review.
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
</FindBugsFilter>