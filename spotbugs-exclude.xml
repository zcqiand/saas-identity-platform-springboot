<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude codegen output (DTO + API) -->
    <Match>
        <Package name="saas.identity.shared.dto"/>
    </Match>
    <Match>
        <Package name="saas.identity.shared.api"/>
    </Match>
    <!-- Spring service/controller singleton injection is fine -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Unboxing/reboxing int parameters in scaffold code -->
    <Match>
        <Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/>
    </Match>
    <!--
      NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: codegen-generated DTO getters are
      declared @Nullable for OpenAPI optional fields. SpotBugs cannot statically
      track short-circuit null checks (a == null ? b : a) and flags false
      positives on every nullable setter. Code is correct under manual review.
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <!--
      CT_CONSTRUCTOR_THROW: Spring @Component bean constructor 校验失败 throw
      IllegalStateException, 容器不发布此 bean — 无 finalizer attack 暴露面。
      例如 JwtIssuer 校验 JWT_SIGNING_KEY ≥32B 时 throw, 静态分析不能识别 Spring
      生命周期, 静默忽略。
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!--
      FixSentinelTimestamps: one-shot 运维脚本（PG -infinity 行 → 1970-01-01，已跑过使命，留作工具）。
      硬编码密码是 dev 库真值（与 .env.local 同源，不进 CI）；SQL 拼接的 table/col
      来自同文件私有常量数组，无外部输入注入面；顶层 throws Exception 是脚本惯例。
      防御性重构对 one-shot 脚本是过度工程，静默忽略。
    -->
    <Match>
        <Class name="saas.identity.platform.FixSentinelTimestamps"/>
    </Match>
</FindBugsFilter>