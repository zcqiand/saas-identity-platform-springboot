# 进仓契约文件(L0.5 门管理):真 secret 由 VPS env-file 注入,此处是 key 契约 + 占位值
#
# key 集合与 .env.example 完全一致;值表语义:「key 契约 + 非 secret 已知 prod 值」。

# —— Server ——
SERVER_PORT=8080

# —— Database（saas_prod 数据库） ——
SPRING_DATASOURCE_URL=jdbc:postgresql://PROD-HOST:5432/saas_prod
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=placeholder-vps
SAAS_DB=saas_prod

# —— CORS ——
# prod 只有 saas 家族前端域名,无 localhost(dev origin 不进 production)。
SAAS_CORS_ALLOWED_ORIGINS=https://saas-react.xiangru.uk,https://saas-vue.xiangru.uk,https://saas-nextjs.xiangru.uk

# —— JWT (HS256;prod 真值由 deploy 脚本首启自举进 springboot.env) ——
JWT_SIGNING_KEY=placeholder-vps
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600
