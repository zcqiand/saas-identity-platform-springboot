{
  "schema": 1,
  "project": "saas-identity-platform-springboot",
  "stack": "java-spring",
  "suite_version": "0.6.0",
  "source_dirs": ["src/main/java", "src/main/resources"],
  "test_dirs": ["src/test/java", "src/test/resources"],
  "gates": {
    "L1": { "name": "格式", "cmd": ["mvn", "-q", "spotless:check"], "fix": "mvn spotless:apply" },
    "L2": { "name": "静态检查", "cmd": ["mvn", "-q", "spotbugs:check"], "fix": "逐条修复 SpotBugs" },
    "L3": { "name": "编译", "cmd": ["mvn", "-q", "-DskipTests", "compile"], "fix": "先让它编译过" },
    "L4": { "name": "测试", "cmd": ["mvn", "-q", "test"], "fix": "先让测试变绿" },
    "L4.db.scaffold": {
      "name": "DB schema scaffold drift",
      "cmd": ["bash", "scripts/scaffold-entities.sh"],
      "fix": "DB 与 entity 不一致：确认 shared 已 db:migrate，然后 bash scripts/scaffold-entities.sh && git add src/main/java/saas/identity/platform/entity/Generated/ && git commit",
      "skip_env": "CI_DB_SCAFFOLD_SKIP=1"
    }
  },
  "trace_cmd": ["mvn", "-q", "test", "-DTRACE_MAP=1"],
  "trace_env": {}
}